{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smogsense:schema:bulletin:1.0",
  "title": "SmogSense public forecast bulletin (forecast/latest.json and forecast/YYYY-MM-DD.json)",
  "description": "Contract between the Python pipeline (publishing/bulletin.py) and everything that consumes the forecast: the static site, the card renderer, third-party scripts. Monotonicity of quantiles and the sum of category probabilities cannot be expressed in JSON Schema and are asserted by tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuance_utc",
    "generated_at_utc",
    "data_cutoff_utc",
    "domain",
    "mode",
    "model",
    "aqi_scheme",
    "horizons",
    "advisory",
    "provenance",
    "disclaimer_key",
    "valid_until_utc"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issuance_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Forecast reference time T0 (00:00 UTC)."
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Latest observation time that was knowable when the forecast was produced."
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "centroid",
        "timezone"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "lahore"
          ]
        },
        "name": {
          "$ref": "#/$defs/bilingual"
        },
        "centroid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "full",
        "stale_cams",
        "observations_only",
        "baseline_only"
      ],
      "description": "Degradation-ladder level in force."
    },
    "mode_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "git_sha",
        "calibrated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "git_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{7,40}|unknown)$"
        },
        "calibrated": {
          "type": "boolean"
        },
        "adaptation_status": {
          "type": "string"
        }
      }
    },
    "aqi_scheme": {
      "const": "us_epa_2024_pm25_24h"
    },
    "horizons": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/horizon"
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "notes"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category_id"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mask_note",
              "indoor_air_note",
              "sensitive_note"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "as_of_utc"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "openaq",
                  "cams_global",
                  "firms"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "stale",
                  "missing"
                ]
              },
              "as_of_utc": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "disclaimer_key": {
      "type": "string"
    },
    "valid_until_utc": {
      "type": "string",
      "format": "date-time"
    },
    "basis": {
      "type": "object",
      "properties": {
        "n_panel": {
          "type": "integer"
        },
        "n_reference": {
          "type": "integer"
        },
        "n_lowcost": {
          "type": "integer"
        },
        "aggregation": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ur"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ur": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category_id": {
      "type": "string",
      "enum": [
        "good",
        "moderate",
        "usg",
        "unhealthy",
        "very_unhealthy",
        "hazardous"
      ]
    },
    "ugm3": {
      "type": "number",
      "minimum": 0
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quantiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q05",
        "q10",
        "q25",
        "q50",
        "q75",
        "q90",
        "q95"
      ],
      "properties": {
        "q05": {
          "$ref": "#/$defs/ugm3"
        },
        "q10": {
          "$ref": "#/$defs/ugm3"
        },
        "q25": {
          "$ref": "#/$defs/ugm3"
        },
        "q50": {
          "$ref": "#/$defs/ugm3"
        },
        "q75": {
          "$ref": "#/$defs/ugm3"
        },
        "q90": {
          "$ref": "#/$defs/ugm3"
        },
        "q95": {
          "$ref": "#/$defs/ugm3"
        }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lead_h",
        "window_start_utc",
        "window_end_utc",
        "window_start_local",
        "window_end_local",
        "quantiles_ugm3",
        "category",
        "probabilities"
      ],
      "properties": {
        "lead_h": {
          "type": "integer",
          "enum": [
            24,
            48,
            72
          ],
          "description": "The forecast is the mean over the 24 hours [T0+lead_h-24h, T0+lead_h) (hour-start labels)."
        },
        "window_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "window_end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "window_start_local": {
          "type": "string",
          "format": "date-time",
          "description": "Same instant in the display time zone (Asia/Karachi)."
        },
        "window_end_local": {
          "type": "string",
          "format": "date-time"
        },
        "quantiles_ugm3": {
          "$ref": "#/$defs/quantiles"
        },
        "category": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower_q10",
            "median_q50",
            "upper_q90"
          ],
          "properties": {
            "lower_q10": {
              "$ref": "#/$defs/category_id"
            },
            "median_q50": {
              "$ref": "#/$defs/category_id"
            },
            "upper_q90": {
              "$ref": "#/$defs/category_id"
            }
          }
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "by_category",
            "exceed"
          ],
          "properties": {
            "by_category": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "good",
                "moderate",
                "usg",
                "unhealthy",
                "very_unhealthy",
                "hazardous"
              ],
              "properties": {
                "good": {
                  "$ref": "#/$defs/probability"
                },
                "moderate": {
                  "$ref": "#/$defs/probability"
                },
                "usg": {
                  "$ref": "#/$defs/probability"
                },
                "unhealthy": {
                  "$ref": "#/$defs/probability"
                },
                "very_unhealthy": {
                  "$ref": "#/$defs/probability"
                },
                "hazardous": {
                  "$ref": "#/$defs/probability"
                }
              }
            },
            "exceed": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold_ugm3",
                  "probability"
                ],
                "properties": {
                  "threshold_ugm3": {
                    "type": "number",
                    "enum": [
                      55.5,
                      125.5,
                      225.5
                    ]
                  },
                  "probability": {
                    "$ref": "#/$defs/probability"
                  }
                }
              }
            }
          }
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_id",
        "name",
        "lat",
        "lon",
        "is_reference",
        "horizons"
      ],
      "properties": {
        "point_id": {
          "type": "string",
          "pattern": "^station:[0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "is_reference": {
          "type": "boolean"
        },
        "horizons": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lead_h",
              "q10",
              "q50",
              "q90",
              "category_median"
            ],
            "properties": {
              "lead_h": {
                "type": "integer",
                "enum": [
                  24,
                  48,
                  72
                ]
              },
              "q10": {
                "$ref": "#/$defs/ugm3"
              },
              "q50": {
                "$ref": "#/$defs/ugm3"
              },
              "q90": {
                "$ref": "#/$defs/ugm3"
              },
              "category_median": {
                "$ref": "#/$defs/category_id"
              }
            }
          }
        }
      }
    }
  }
}
