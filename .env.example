# =============================================================================
# SmogSense environment template.  Copy to `.env` (git-ignored) and fill in.
# NEVER commit real values.  In GitHub Actions these are repository SECRETS.
# Every credential below is free to obtain; see docs/deployment-and-ops.md.
# =============================================================================

# --- Required for live operation ---------------------------------------------
# OpenAQ v3 API key (free): https://explore.openaq.org/register  -> 60 req/min, 2000 req/h
OPENAQ_API_KEY=

# Atmosphere Data Store (CAMS) personal access token: https://ads.atmosphere.copernicus.eu  (profile page)
# You must also click "Accept licence" once on the dataset page, or requests fail with HTTP 403.
ADS_API_KEY=

# Climate Data Store (ERA5) personal access token: https://cds.climate.copernicus.eu  (profile page)
CDS_API_KEY=

# NASA FIRMS MAP_KEY (free, e-mail only): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Optional -----------------------------------------------------------------
# NASA Earthdata bearer token — only for the research-only MAIAC AOD module
EARTHDATA_TOKEN=
# Telegram channel mirror of the daily card (free Bot API). WhatsApp automation is intentionally NOT supported (billed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Pages mirror (free plan, direct upload)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Behaviour ----------------------------------------------------------------
# live = real network | fixtures = replay tests/fixtures (offline demo and unit tests)
SMOGSENSE_MODE=live
SMOGSENSE_LOG_LEVEL=INFO

# --- Container user mapping (avoids root-owned files on bind mounts) -------------
# Linux/macOS: `id -u` and `id -g`.  GitHub Actions: set automatically by the workflows.
HOST_UID=1000
HOST_GID=1000
