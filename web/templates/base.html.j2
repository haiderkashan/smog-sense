<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none';">
  <title>{{ page.title }}</title>
  <meta name="description" content="{{ t('meta.tagline') }}">
  <link rel="canonical" href="{{ page.canonical_url }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ page.canonical_url }}">
  <link rel="alternate" hreflang="{{ 'ur' if lang == 'en' else 'en' }}" href="{{ page.alternate_lang_url }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.base_url }}/">

  <!-- Open Graph & Social Cards -->
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:description" content="{{ t('meta.tagline') }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ page.canonical_url }}">
  <meta property="og:image" content="{{ page.og_image_url }}">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Design Tokens and Base Styles -->
  <link rel="stylesheet" href="{{ site.asset('css/tokens.css') }}">
  <link rel="stylesheet" href="{{ site.asset('css/base.css') }}">
  {% if dir == 'rtl' %}
  <link rel="stylesheet" href="{{ site.asset('css/rtl.css') }}">
  {% endif %}

  <!-- Urdu Font Preload -->
  {% if lang == 'ur' %}
  <link rel="preload" href="{{ site.asset('fonts/noto-nastaliq-urdu.woff2') }}" as="font" type="font/woff2" crossorigin>
  {% endif %}
</head>
<body>
  <a class="skip-link" href="#forecast">{{ t('a11y.skip_to_forecast') }}</a>

  <header class="site-header" role="banner">
    <div class="site-header__container">
      <div class="brand">
        <div class="brand__title-row">
          <span class="brand__icon" aria-hidden="true">
            <svg class="brand__logo-svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            </svg>
          </span>
          <span class="brand__title">{{ t('meta.site_title') }}</span>
        </div>
        <span class="brand__tagline">{{ t('meta.tagline') }}</span>
      </div>
      <nav class="site-nav" aria-label="Main Navigation">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" title="Toggle dark/light theme">
          <span class="theme-toggle__icon" aria-hidden="true">🌓</span>
        </button>
        {% include "partials/_language_switch.html.j2" %}
      </nav>
    </div>
  </header>

  <main id="forecast" class="main-content" role="main">
    {% block content %}{% endblock %}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__container">
      <p class="disclaimer">{{ t('disclaimer') }}</p>
      <p class="attribution">{{ t('attribution') }}</p>
    </div>
  </footer>

  <script defer src="{{ site.asset('js/dashboard.js') }}"></script>
</body>
</html>
