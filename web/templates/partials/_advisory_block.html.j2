{# Protective health advisory block partial #}
<section class="advisory-block" aria-labelledby="advisory-heading">
  <h2 id="advisory-heading" class="section-heading">{{ t('advice.' ~ bulletin.advisory.category ~ '.headline') }}</h2>

  <ul class="advisory-actions">
    {% for action in t('advice.' ~ bulletin.advisory.category ~ '.actions') %}
      <li class="advisory-action-item">{{ action }}</li>
    {% endfor %}
  </ul>

  {% if bulletin.advisory.notes %}
  <div class="advisory-notes">
    {% for note_key in bulletin.advisory.notes %}
      <div class="advisory-note advisory-note--{{ note_key }}">
        <p>{{ t('notes.' ~ note_key) }}</p>
      </div>
    {% endfor %}
  </div>
  {% endif %}
</section>
