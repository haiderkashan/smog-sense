{# AQI category chip partial with geometric non-color cues #}
<span class="aqi-chip aqi-chip--{{ category_id }}" data-category="{{ category_id }}">
  <span class="aqi-chip__shape aqi-chip__shape--{{ category_id }}" aria-hidden="true">
    {% if category_id == 'good' %}●
    {% elif category_id == 'moderate' %}■
    {% elif category_id == 'usg' %}▲
    {% elif category_id == 'unhealthy' %}◆
    {% elif category_id == 'very_unhealthy' %}⬡
    {% elif category_id == 'hazardous' %}🛑
    {% else %}●
    {% endif %}
  </span>
  <span class="aqi-chip__text">{{ label }}</span>
</span>
