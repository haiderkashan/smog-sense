{# Natural frequency uncertainty explainer partial #}
<section class="uncertainty-legend" aria-labelledby="uncertainty-heading">
  <div class="uncertainty-legend__header">
    <span class="uncertainty-badge" aria-hidden="true">📊 {{ t('uncertainty.badge') }}</span>
    <h2 id="uncertainty-heading" class="section-heading">{{ t('uncertainty.range_label') }}</h2>
  </div>
  <p class="uncertainty-explainer-text">{{ t('uncertainty.explain_short') }}</p>

  <div class="legend-grid">
    <div class="legend-card legend-card--median">
      <span class="legend-card__tag">{{ t('uncertainty.median_label') }}</span>
      <p class="legend-card__desc">{{ t('uncertainty.median_desc') }}</p>
    </div>
    <div class="legend-card legend-card--range">
      <span class="legend-card__tag">{{ t('uncertainty.range_label') }}</span>
      <p class="legend-card__desc">{{ t('uncertainty.range_desc') }}</p>
    </div>
    <div class="legend-card legend-card--upper">
      <span class="legend-card__tag">{{ t('uncertainty.upper_label') }}</span>
      <p class="legend-card__desc">{{ t('uncertainty.upper_desc') }}</p>
    </div>
  </div>
</section>
